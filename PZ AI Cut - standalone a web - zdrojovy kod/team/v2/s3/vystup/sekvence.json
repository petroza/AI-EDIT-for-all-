rt":10.2,"in":270.68,"out":276.12,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":15.64,"in":121.32,"out":128.52,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"}],[],[]],"captions":[{"start":0.02,"end":1.567,"text":"Když přijde\nrodina"},{"start":1.567,"end":3.67,"text":"o člověka\njako je máma?"},{"start":3.92,"end":5.41,"text":"A najednou\nbyl pryč."},{"start":5.55,"end":7.52,"text":"Tady není\njiná možnost."},{"start":7.75,"end":8.757,"text":"Ty nemáš\nv tu chvíli"},{"start":8.757,"end":10.25,"text":"jako vlastně\njinou možnost."},{"start":10.27,"end":11.316,"text":"A to je\nteda krásný,"},{"start":11.316,"end":12.71,"text":"že odvážním\nštěstí přeje."},{"start":12.71,"end":14.792,"text":"Ty jsi prostě byla\nodvážná a řekla si,"},{"start":14.792,"end":15.69,"text":"já to zkusím."},{"start":15.72,"end":17.115,"text":"Vlastně jsem\nsi pak uvědomila,"},{"start":17.115,"end":18.735,"text":"že bych radši si ty\npříběhy vlastně"},{"start":18.735,"end":20.532,"text":"jako psala sama\na proto jsem"},{"start":20.532,"end":22.84,"text":"se dostala na novu\njako reportérka."}]},"s3-a1080":{"w":1920,"h":1080,"fps":25,"captionStyle":{"lines":2,"maxChars":40,"size":1,"pos":5,"color":"#ffffff","box":false,"highlight":""},"video":[[{"start":0,"in":104.6,"out":107.36,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":2.76,"in":114.88,"out":119.64,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":7.52,"in":145.96,"out":151.16,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":12.72,"in":187.96,"out":191.24,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"audio":[[{"start":0,"in":104.6,"out":107.36,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":2.76,"in":114.88,"out":119.36,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":7.24,"in":145.68,"out":151.16,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":12.72,"in":187.96,"out":191.24,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"captions":[{"start":0.13,"end":2.76,"text":"A zjistilo se to strašně,\nstrašně pozdě."},{"start":3.13,"end":5.154,"text":"Takže to přišlo úplně,\njak my jsme se rozvěděli,"},{"start":5.154,"end":7.18,"text":"že je nemocná a za tři\ntýdny byla pryč."},{"start":7.36,"end":8.84,"text":"Všechno, naprosto všechno,"},{"start":8.84,"end":12.53,"text":"protože moje máma byla\ntmel té naší rodiny."},{"start":12.932,"end":16,"text":"a byla to ta nejtěžší\nvěc v mým životě."}]},"s3-e1080":{"w":1920,"h":1080,"fps":25,"captionStyle":{"lines":2,"maxChars":40,"size":1,"pos":5,"color":"#ffffff","box":false,"highlight":""},"video":[[{"start":0,"in":16.36,"out":18.4,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":2.04,"in":119.48,"out":123.72,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":6.28,"in":181.64,"out":185.16,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"audio":[[{"start":0,"in":16.36,"out":18.4,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":2.04,"in":119.48,"out":123.72,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":6.28,"in":181.64,"out":185.16,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"captions":[{"start":0.6,"end":1.99,"text":"Tady není jiná možnost."},{"start":2.415,"end":5.96,"text":"My jsme vlastně vůbec neměli\nmožnost se na to připravit."},{"start":6.48,"end":8.25,"text":"To byl prostě můj\nnejbližší člověk."},{"start":8.885,"end":9.8,"text":"A najednou byl pryč."}]}}
