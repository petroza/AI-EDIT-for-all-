í"},{"start":14.817,"end":16,"text":"věc v mým\nživotě."}]},"s3-d16":{"w":1280,"h":720,"fps":25,"video":[[{"start":0,"in":127.36,"out":136.24,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":8.88,"in":145.96,"out":163.12,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":26.04,"in":183.56,"out":185.16,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"audio":[[{"start":0,"in":127.36,"out":135.96,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":8.6,"in":145.68,"out":163.12,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":26.04,"in":183.56,"out":185.16,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"captions":[]},"s3-d":{"w":1080,"h":1080,"fps":25,"captionStyle":{"lines":2,"maxChars":30,"size":1,"pos":7,"color":"#ffffff","box":false,"highlight":""},"video":[[{"start":0,"in":127.36,"out":136.24,"fit":"cover","posX":0.49454637254987444,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":8.88,"in":145.96,"out":163.12,"fit":"cover","posX":0.49157521384102965,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":26.04,"in":183.56,"out":184.96,"fit":"cover","posX":0.4767196655273438,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":27.44,"in":184.96,"out":185.16,"fit":"cover","posX":1,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"audio":[[{"start":0,"in":127.36,"out":135.96,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":8.6,"in":145.68,"out":163.12,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":26.04,"in":183.56,"out":185.16,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"captions":[{"start":0.01,"end":4.67,"text":"nebyla možnost se\npřipravit a jediné,"},{"start":4.67,"end":8.56,"text":"co nám zbylo, tak se s tím\npoprat, prostě zvládnout to."},{"start":8.72,"end":10.2,"text":"Všechno,\nnaprosto všechno,"},{"start":10.2,"end":13.89,"text":"protože moje máma byla\ntmel té naší rodiny."},{"start":14.095,"end":15.352,"text":"To byl někdo,"},{"start":15.352,"end":20.138,"text":"kdo držel celou rodinu\npohromadě a kdo svolával"},{"start":20.138,"end":24.7,"text":"nás všechny na obědy,\nsvátky, narozeniny."},{"start":24.7,"end":26.006,"text":"Ona všechno\norganizovala."},{"start":26.725,"end":27.64,"text":"A najednou byl pryč."}]},"s3-e":{"w":1280,"h":720,"fps":25,"captionStyle":{"lines":2,"maxChars":40,"size":1,"pos":5,"color":"#ffffff","box":false,"highlight":""},"video":[[{"start":0,"in":16.36,"out":18.4,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":2.04,"in":119.48,"out":123.72,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"},{"start":6.28,"in":181.64,"out":185.16,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"audio":[[{"start":0,"in":16.36,"out":18.4,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":2.04,"in":119.48,"out":123.72,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"},{"start":6.28,"in":181.64,"out":185.16,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"vyrez-5min.mp4"}],[],[]],"captions":[{"start":0.6,"end":1.99,"text":"Tady není jiná možnost."},{"start":2.415,"end":5.96,"text":"My jsme vlastně vůbec neměli\nmožnost se na to připravit."},{"start":6.48,"end":8.25,"text":"To byl prostě můj\nnejbližší člověk."},{"start":8.885,"end":9.8,"text":"A najednou byl pryč."}]},"s3-sim":{"w":1280,"h":720,"fps":25,"captionStyle":{"lines":2,"maxChars":40,"size":1,"pos":5,"color":"#ffffff","box":false,"highlight":""},"video":[[{"start":0,"in":1544.4,"out":1574.2,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":29.8,"in":1596,"out":1612.12,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"}],[],[]],"audio":[[{"start":0,"in":1544.4,"out":1574.2,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":29.8,"in":1596,"out":1612.12,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"}],[],[]],"captions":[{"start":0.19,"end":5.058,"text":"Bych jako doporučila všem, kdo\npřichází nebo přišli do styku s někým,"},{"start":5.058,"end":9.666,"text":"komu se tohle stalo,\ntak neříkat tyhle fádní věci,"},{"start":9.666,"end":14.414,"text":"často zahojí, je teď líp,\ntak to mělo být, tohle fakt nepomáhá."},{"start":14.414,"end":18.165,"text":"Prostě my ani nepotřebujeme nic slyšet,\nmy potřebujeme jenom toho člověka,"},{"start":18.165,"end":22.254,"text":"aby s náma byl, aby, když se třeba\ndlouho neozýváme, aby zavolal a řekl,"},{"start":22.254,"end":26.355,"text":"já jedu za tebou, já ti vezu jídlo,\nnebo prostě pojď, kouknem se na film."},{"start":26.384,"end":29.8,"text":"Jenom ta přítomnost toho člověka\nchytne vás za ruku, něco. prostě."},{"start":29.99,"end":34.5,"text":"Ale my nepotřebujeme prostě někoho, aby\nnám říkal takový ty chlácholivý věci."},{"start":35.53,"end":39.414,"text":"Jí už je teď dobře.\nTo nepotřebujeme slyšet."},{"start":39.414,"end":42.745,"text":"Já potřebuju slyšet něco\njako máma byla skvělá,"},{"start":42.745,"end":45.92,"text":"tak jim i chybí a jsem tady\npro tebe, kdyby cokoliv."}]},"s3-sim916":{"w":1080,"h":1920,"fps":25,"captionStyle":{"lines":2,"maxChars":20,"size":1,"pos":30,"color":"#ffffff","box":false,"highlight":""},"video":[[{"start":0,"in":1544.4,"out":1574.2,"fit":"cover","posX":0.3169070521763395,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":29.8,"in":1596,"out":1599.76,"fit":"cover","posX":0.7542564958844864,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":33.56,"in":1599.76,"out":1612.12,"fit":"cover","posX":0.2896156529017859,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"}],[],[]],"audio":[[{"start":0,"in":1544.4,"out":1574.2,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":29.8,"in":1596,"out":1612.12,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"}],[],[]],"captions":[{"start":0.19,"end":1.826,"text":"Bych jako\ndoporučila všem,"},{"start":1.826,"end":4.06,"text":"kdo přichází nebo\npřišli do styku"},{"start":4.06,"end":6.095,"text":"s někým, komu\nse tohle stalo,"},{"start":6.095,"end":9.666,"text":"tak neříkat\ntyhle fádní věci,"},{"start":9.666,"end":12.699,"text":"často zahojí, je teď\nlíp, tak to mělo"},{"start":12.699,"end":14.414,"text":"být, tohle\nfakt nepomáhá."},{"start":14.414,"end":15.91,"text":"Prostě my ani\nnepotřebujeme"},{"start":15.91,"end":17.187,"text":"nic slyšet,\nmy potřebujeme"},{"start":17.187,"end":18.165,"text":"jenom toho\nčlověka,"},{"start":18.165,"end":20.619,"text":"aby s náma byl,\naby, když se třeba"},{"start":20.619,"end":21.417,"text":"dlouho\nneozýváme,"},{"start":21.417,"end":23.412,"text":"aby zavolal a řekl,\njá jedu za tebou,"},{"start":23.412,"end":25.506,"text":"já ti vezu jídlo,\nnebo prostě pojď,"},{"start":25.506,"end":26.355,"text":"kouknem\nse na film."},{"start":26.384,"end":27.501,"text":"Jenom ta\npřítomnost toho"},{"start":27.501,"end":29.456,"text":"člověka chytne\nvás za ruku, něco."},{"start":29.456,"end":29.8,"text":"prostě. Ale my\nnepotřebujeme"},{"start":31.05,"end":32.71,"text":"prostě někoho,\naby nám říkal"},{"start":32.71,"end":34.5,"text":"takový ty\nchlácholivý věci."},{"start":35.53,"end":37.12,"text":"Jí už je\nteď dobře."},{"start":37.37,"end":39.414,"text":"To nepotřebujeme\nslyšet."},{"start":39.414,"end":42.009,"text":"Já potřebuju slyšet\nněco jako máma"},{"start":42.009,"end":44.053,"text":"byla skvělá, tak jim\ni chybí a jsem"},{"start":44.053,"end":45.92,"text":"tady pro tebe,\nkdyby cokoliv."}]},"S3V upoutavka":{"w":1280,"h":720,"fps":25,"captionStyle":{"lines":2,"maxChars":40,"size":1,"pos":5,"color":"#ffffff","box":false},"video":[[{"start":0,"in":1216.08,"out":1219.88,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":3.8,"in":1263.56,"out":1264.96,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":5.2,"in":1095.92,"out":1100.92,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":10.2,"in":270.68,"out":276.12,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":15.64,"in":121.32,"out":128.52,"fit":"contain","posX":0,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"}],[],[]],"audio":[[{"start":0,"in":1216.08,"out":1219.88,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":3.8,"in":1263.56,"out":1265.12,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":5.36,"in":1096.08,"out":1100.92,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":10.2,"in":270.68,"out":276.12,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":15.64,"in":121.32,"out":128.52,"fit":"contain","posX":0,"fadeIn":0.08,"fadeOut":0.08,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"}],[],[]],"captions":[{"start":0.02,"end":3.67,"text":"Když přijde rodina\no člověka jako je máma?"},{"start":3.92,"end":7.52,"text":"A najednou byl pryč.\nTady není jiná možnost."},{"start":7.75,"end":10.25,"text":"Ty nemáš v tu chvíli\njako vlastně jinou možnost."},{"start":10.27,"end":12.71,"text":"A to je teda krásný,\nže odvážním štěstí přeje."},{"start":12.71,"end":15.69,"text":"Ty jsi prostě byla odvážná\na řekla si, já to zkusím."},{"start":15.72,"end":18.735,"text":"Vlastně jsem si pak uvědomila,\nže bych radši si ty příběhy vlastně"},{"start":18.735,"end":22.84,"text":"jako psala sama a proto jsem se\ndostala na novu jako reportérka."}]},"S3V upoutavka 916":{"w":1080,"h":1920,"fps":25,"captionStyle":{"lines":2,"maxChars":20,"size":1,"pos":30,"color":"#ffffff","box":false},"video":[[{"start":0,"in":1216.08,"out":1217.04,"fit":"cover","posX":0.29856274414062467,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":0.96,"in":1217.04,"out":1219.44,"fit":"cover","posX":-0.5900941598074777,"fadeIn":0,"fadeOut":0,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOR