437498024,"posY":0,"scale":1},{"start":6.84,"in":73.88000000000001,"out":77.84,"fit":"cover","posX":0.9254899359796627,"posY":0,"scale":1},{"start":10.8,"in":77.84,"out":85.88,"fit":"cover","posX":0.39287770524134613,"posY":0,"scale":1},{"start":18.84,"in":212.04,"out":221.51999999999998,"fit":"cover","posX":0.36250420422140084,"posY":0,"scale":1},{"start":28.32,"in":221.51999999999998,"out":227.23999999999998,"fit":"cover","posX":0.9217838451634883,"posY":0,"scale":1},{"start":34.04,"in":227.23999999999998,"out":228.28,"fit":"cover","posX":0.4079048545548607,"posY":0,"scale":1}],[],[]],"audio":[[{"start":0,"in":67.04,"out":85.88,"fadeIn":0.0032,"fadeOut":0.0032},{"start":18.84,"in":212.04,"out":228.28,"fadeIn":0.0032,"fadeOut":0.0032}],[],[]],"captions":[{"start":0.01,"end":3.953,"text":"A vlastně po strašně dlouhé\ndobě a po strašně moc","ws":[0.01,0.168,0.799,1.035,1.666,2.218,2.612,2.77,3.006,3.637]},{"start":3.953,"end":7.895,"text":"vyšetření, až když ona\nopravdu nemohla ani chodit","ws":[3.953,4.82,5.057,5.451,5.766,6.397,7.028,7.343]},{"start":7.895,"end":11.195,"text":"bolestí, zjistili teprve,\nže ona měla vzácnou","ws":[7.895,8.605,9.235,9.795,10.005,10.285,10.635]},{"start":11.195,"end":14.605,"text":"formu rakovin, jmenuje\nse to mnohočetný myelom,","ws":[11.195,11.615,12.245,12.817,13.032,13.246,14.033]},{"start":14.605,"end":18.505,"text":"což je věc, o které jsem\ndoposavať nikdy neslyšela.","ws":[14.605,14.905,15.13,15.505,15.655,16.105,16.48,17.23,17.68]},{"start":18.505,"end":21.126,"text":"Nikdo Že vlastně jako to,\nco se stalo,","ws":[18.505,19.12,19.302,19.789,20.093,20.336,20.518,20.701]},{"start":21.126,"end":23.74,"text":"tak ti dá takovou\njako bombu, takovou ránu","ws":[21.126,21.369,21.552,21.734,22.22,22.524,22.95,23.436]},{"start":23.74,"end":26.308,"text":"a vlastně ty spadneš\núplně fakt jako na dno.","ws":[23.74,23.848,24.282,24.445,24.879,25.204,25.475,25.746,25.909]},{"start":27.16,"end":28.314,"text":"A to, jak\nse zvedneš,","ws":[27.16,27.265,27.475,27.685,27.842]},{"start":28.314,"end":31.2,"text":"tak potom tě jako sformuje\npodle mě už jako navždycky.","ws":[28.314,28.524,28.839,28.996,29.259,29.731,30.046,30.203,30.361,30.623]},{"start":31.2,"end":32.576,"text":"Protože prostě\nten člověk,","ws":[31.2,31.608,31.964,32.168]},{"start":32.576,"end":35.046,"text":"který byl před tímhle vším,\ntak už jako není.","ws":[32.576,32.882,33.085,33.34,33.697,34.003,34.207,34.359,34.614]}]},"vystup-r7-d":{"w":1280,"h":720,"fps":25,"title":null,"captionStyle":null,"video":[[{"start":0,"in":128.24,"out":136.04,"fit":"contain","posX":0,"posY":0,"scale":1},{"start":7.8,"in":145.88,"out":163.20000000000002,"fit":"contain","posX":0,"posY":0,"scale":1},{"start":25.12,"in":184.08,"out":185.36,"fit":"contain","posX":0,"posY":0,"scale":1}],[],[]],"audio":[[{"start":0,"in":128.24,"out":136.04,"fadeIn":0.0032,"fadeOut":0.0032},{"start":7.8,"in":145.88,"out":163.20000000000002,"fadeIn":0.0032,"fadeOut":0.0032},{"start":25.12,"in":184.08,"out":185.36,"fadeIn":0.0032,"fadeOut":0.0032}],[],[]],"captions":[{"start":0.105,"end":3.54,"text":"Nebyla možnost se\npřipravit a jediné,","ws":[0.105,0.738,1.461,1.732,2.636,2.817]},{"start":3.54,"end":7.8,"text":"co nám zbylo, tak se s tím\npoprat, zvládnout.","ws":[3.54,3.811,4.172,4.805,5.18,5.461,5.649,6.024,6.774]},{"start":7.8,"end":9.83,"text":"Všechno, naprosto všechno,","ws":[7.8,8.453,9.141]},{"start":9.83,"end":12.965,"text":"protože moje máma\nbyla tmel naší rodiny.","ws":[9.83,10.441,10.824,11.206,11.589,11.971,12.353]},{"start":12.965,"end":15.98,"text":"To byl někdo,\nkdo držel celou rodinu,","ws":[12.965,13.203,13.52,14.076,14.393,14.869,15.345]},{"start":15.98,"end":20.782,"text":"pohromadě a kdo zvolával\nnás jako všechny,","ws":[15.98,17.33,17.6,18.099,19.221,19.72,20.099]},{"start":20.782,"end":25.06,"text":"jako na obědy, prostě svátky,\nnarození, ona všechno organizovala.","ws":[20.782,21.161,21.389,22.16,22.608,23.12,23.8,23.978,24.335]},{"start":25.175