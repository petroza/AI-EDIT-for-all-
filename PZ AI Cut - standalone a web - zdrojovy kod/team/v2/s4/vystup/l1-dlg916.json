{"seq":"s4-L1dlg916","n":46,"maxLines":1,"style":{"lines":1,"maxChars":20,"size":1,"pos":30,"color":"#ffffff","box":false,"highlight":""},"caps":[[0.19,0.689,"Bych jako"],[0.689,1.826,"doporučila všem,"],[1.826,3.083,"kdo přichází nebo"],[3.083,4.06,"přišli do styku"],[4.06,5.317,"s někým, komu"],[5.317,6.793,"se tohle stalo, tak"],[6.793,8.848,"neříkat tyhle fádní"],[8.848,10.704,"věci, často zahojí,"],[10.704,12.26,"je teď líp, tak"],[12.26,13.616,"to mělo být, tohle"],[13.616,14.414,"fakt nepomáhá."],[14.414,15.073,"Prostě my"],[15.073,15.91,"ani nepotřebujeme"],[15.91,16.609,"nic slyšet,"],[16.609,17.187,"my potřebujeme"],[17.187,17.546,"jenom toho"],[17.546,18.165,"člověka,"],[18.165,19.222,"aby s náma byl,"],[19.222,20.619,"aby, když se třeba"],[20.619,20.818,"dlouho"],[20.818,21.417,"neozýváme,"],[21.417,22.254,"aby zavolal a řekl,"],[22.254,23.412,"já jedu za tebou,"],[23.412,24.249,"já ti vezu jídlo,"],[24.249,25.506,"nebo prostě pojď,"],[25.506,25.746,"kouknem"],[25.746,26.703,"se na film. Jenom"],[26.703,27.501,"ta přítomnost toho"],[27.501,28.399,"člověka chytne"],[28.399,29.456,"vás za ruku, něco."],[29.456,29.799999999999955,"prostě."],[29.99,30.49,"Ale my"],[30.49,31.05,"nepotřebujeme"],[31.05,31.69,"prostě někoho,"],[31.69,32.71,"aby nám říkal"],[32.71,33.35,"takový ty"],[33.35,34.5,"chlácholivý věci."],[35.53,37.12,"Jí už je teď dobře."],[37.37,38.842,"To nepotřebujeme"],[38.842,39.414,"slyšet."],[39.414,40.313,"Já potřebuju slyšet"],[40.313,42.009,"něco jako máma"],[42.009,43.134,"byla skvělá, tak jim"],[43.134,44.053,"i chybí a jsem"],[44.053,44.85,"tady pro tebe,"],[44.85,45.92,"kdyby cokoliv."]]}
