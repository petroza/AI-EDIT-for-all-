   [
    0.19,
    5.058,
    "Bych jako doporučila všem, kdo / přichází nebo přišli do styku s někým,"
   ],
   [
    5.058,
    9.666,
    "komu se tohle stalo, / tak neříkat tyhle fádní věci,"
   ],
   [
    9.666,
    14.414,
    "často zahojí, je teď líp, / tak to mělo být, tohle fakt nepomáhá."
   ],
   [
    14.414,
    18.165,
    "Prostě my ani nepotřebujeme nic slyšet, / my potřebujeme jenom toho člověka,"
   ],
   [
    18.165,
    22.254,
    "aby s náma byl, aby, když se třeba / dlouho neozýváme, aby zavolal a řekl,"
   ],
   [
    22.254,
    26.355,
    "já jedu za tebou, já ti vezu jídlo, / nebo prostě pojď, kouknem se na film."
   ],
   [
    26.384,
    29.8,
    "Jenom ta přítomnost toho člověka / chytne vás za ruku, něco. prostě."
   ],
   [
    29.99,
    34.5,
    "Ale my nepotřebujeme prostě někoho, aby / nám říkal takový ty chlácholivý věci."
   ],
   [
    35.53,
