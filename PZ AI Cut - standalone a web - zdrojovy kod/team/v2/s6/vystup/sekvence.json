kat tyhle fádní\nvěci, často zahojí,"},{"start":10.704,"end":14.414,"text":"je teď líp, tak to mělo být,\ntohle fakt nepomáhá."},{"start":14.414,"end":17.187,"text":"Prostě my ani nepotřebujeme\nnic slyšet, my potřebujeme"},{"start":17.187,"end":20.619,"text":"jenom toho člověka, aby s náma\nbyl, aby, když se třeba"},{"start":20.619,"end":23.412,"text":"dlouho neozýváme, aby zavolal\na řekl, já jedu za tebou,"},{"start":23.412,"end":26.384,"text":"já ti vezu jídlo, nebo prostě\npojď, kouknem se na film."},{"start":26.384,"end":27.94,"text":"Jenom ta přítomnost\ntoho člověka"},{"start":27.94,"end":29.85,"text":"chytne vás za ruku,\nněco. prostě."},{"start":29.99,"end":31.69,"text":"Ale my nepotřebujeme\nprostě někoho,"},{"start":31.69,"end":34.55,"text":"aby nám říkal takový\nty chlácholivý věci."},{"start":35.53,"end":39.414,"text":"Jí už je teď dobře.\nTo nepotřebujeme slyšet."},{"start":39.414,"end":42.745,"text":"Já potřebuju slyšet něco\njako máma byla skvělá,"},{"start":42.745,"end":45.92,"text":"tak jim i chybí a jsem tady\npro tebe, kdyby cokoliv."},{"start":45.92,"end":49.92,"text":"A pak jsem začala dělat\nmoderátorku v rádiu."}]},"s6-multiES":{"w":1280,"h":720,"fps":25,"captionStyle":{"lines":2,"maxChars":40,"size":1,"pos":5,"color":"#ffffff","box":false,"highlight":""},"video":[[{"start":0,"in":1544.4,"out":1574.2,"fit":"contain","posX":0,"gainDb":0,"fadeIn":0,"fadeOut":0,"vIn":null,"vOut":null,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":29.8,"in":1596,"out":1612.12,"fit":"contain","posX":0,"gainDb":0,"fadeIn":0,"fadeOut":0,"vIn":{"type":"cross","dur":1},"vOut":null,"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"},{"start":45.92,"in":749.52,"out":753.68,"fit":"contain","posX":0,"gainDb":0,"fadeIn":0,"fadeOut":0,"vIn":{"type":"cross","dur":1},"vOut":{"type":"dipBlack","dur":1},"disabled":false,"media":"tncz-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B2