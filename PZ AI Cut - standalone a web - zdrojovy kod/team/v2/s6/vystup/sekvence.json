":0,"vIn":null,"vOut":null,"disabled":false,"media":"mus_stem.wav"}]],"muted":[false,false,false],"captions":[{"start":0.19,"end":1.826,"text":"Bych jako\ndoporučila všem,"},{"start":1.826,"end":4.06,"text":"kdo přichází nebo\npřišli do styku"},{"start":4.06,"end":6.095,"text":"s někým, komu\nse tohle stalo,"},{"start":6.095,"end":9.666,"text":"tak neříkat\ntyhle fádní věci,"},{"start":9.666,"end":12.699,"text":"často zahojí, je teď\nlíp, tak to mělo"},{"start":12.699,"end":14.414,"text":"být, tohle\nfakt nepomáhá."},{"start":14.414,"end":15.91,"text":"Prostě my ani\nnepotřebujeme"},{"start":15.91,"end":17.187,"text":"nic slyšet,\nmy potřebujeme"},{"start":17.187,"end":18.165,"text":"jenom toho\nčlověka,"},{"start":18.165,"end":20.619,"text":"aby s náma byl,\naby, když se třeba"},{"start":20.619,"end":21.417,"text":"dlouho\nneozýváme,"},{"start":21.417,"end":23.412,"text":"aby zavolal a řekl,\njá jedu za tebou,"},{"start":23.412,"end":25.506,"text":"já ti vezu jídlo,\nnebo prostě pojď,"},{"start":25.506,"end":26.384,"text":"kouknem\nse na film."},{"start":26.384,"end":27.501,"text":"Jenom ta\npřítomnost toho"},{"start":27.501,"end":28.997,"text":"člověka chytne\nvás za ruku,"},{"start":28.997,"end":29.85,"text":"něco. prostě."},{"start":29.99,"end":31.05,"text":"Ale my\nnepotřebujeme"},{"start":31.05,"end":32.71,"text":"prostě někoho,\naby nám říkal"},{"start":32.71,"end":34.55,"text":"takový ty\nchlácholivý věci."},{"start":35.53,"end":37.37,"text":"Jí už je\nteď dobře."},{"start":37.37,"end":39.414,"text":"To nepotřebujeme\nslyšet."},{"start":39.414,"end":42.009,"text":"Já potřebuju slyšet\nněco jako máma"},{"start":42.009,"end":44.053,"text":"byla skvělá, tak jim\ni chybí a jsem"},{"start":44.053,"end":45.92,"text":"tady pro tebe,\nkdyby cokoliv."},{"start":45.92,"end":48.2,"text":"A pak jsem\nzačala dělat"},{"start":48.2,"end":49.92,"text":"moderátorku\nv rádiu."}]},"s6-multi11":{"w":1080,"h":1080,"fps":25,"captionStyle":{"lines":2,"maxChars":30,"size":1,"pos":7