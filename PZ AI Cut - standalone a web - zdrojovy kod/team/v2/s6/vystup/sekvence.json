z-TIT_2026-11-20_TALK-TALK_S_BARBOROU_SIMKOVOU-B240845.mp4.mp4"}],[{"start":8,"in":30,"out":34,"fit":"contain","posX":0,"gainDb":-12,"fadeIn":0,"fadeOut":0,"vIn":null,"vOut":null,"disabled":false,"media":"vyrez-5min.mp4"},{"start":27,"in":200,"out":206,"fit":"contain","posX":0,"gainDb":-12,"fadeIn":0,"fadeOut":0,"vIn":null,"vOut":null,"disabled":false,"media":"vyrez-5min.mp4"},{"start":40,"in":120,"out":123,"fit":"contain","posX":0,"gainDb":-12,"fadeIn":0,"fadeOut":0,"vIn":null,"vOut":null,"disabled":false,"media":"vyrez-5min.mp4"}],[{"start":0,"in":0,"out":50.08,"fit":"contain","posX":0,"gainDb":-18,"fadeIn":0,"fadeOut":0,"vIn":null,"vOut":null,"disabled":false,"media":"mus_stem.wav"}]],"muted":[false,false,false],"captions":[{"start":0.19,"end":5.058,"text":"Bych jako doporučila všem, kdo\npřichází nebo přišli do styku s někým,"},{"start":5.058,"end":9.666,"text":"komu se tohle stalo,\ntak neříkat tyhle fádní věci,"},{"start":9.666,"end":14.414,"text":"často zahojí, je teď líp,\ntak to mělo být, tohle fakt nepomáhá."},{"start":14.414,"end":18.165,"text":"Prostě my ani nepotřebujeme nic slyšet,\nmy potřebujeme jenom toho člověka,"},{"start":18.165,"end":22.254,"text":"aby s náma byl, aby, když se třeba\ndlouho neozýváme, aby zavolal a řekl,"},{"start":22.254,"end":26.355,"text":"já jedu za tebou, já ti vezu jídlo,\nnebo prostě pojď, kouknem se na film."},{"start":26.384,"end":29.8,"text":"Jenom ta přítomnost toho člověka\nchytne vás za ruku, něco. prostě."},{"start":29.99,"end":34.5,"text":"Ale my nepotřebujeme prostě někoho, aby\nnám říkal takový ty chlácholivý věci."},{"start":35.53,"end":39.414,"text":"Jí už je teď dobře.\nTo nepotřebujeme slyšet."},{"start":39.414,"end":42.745,"text":"Já potřebuju slyšet něco\njako máma byla skvělá,"},{"start":42.745,"end":45.92,"text":"tak jim i chybí a jsem tady\npro tebe, kdyby cokoliv."},{"start":45.92,"end":49.87,"text":"A pak jsem začala dělat\nmoderátorku v rádiu."}]},"s6-ctrl":{"w":1280,"h":720,"fps":25,"captionStyle":{