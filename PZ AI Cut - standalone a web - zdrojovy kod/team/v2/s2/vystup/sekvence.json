ěk.","ws":[6.48,6.76,6.92,7.1,7.24,7.56]},{"start":8.885,"end":9.799999999999983,"text":"A najednou byl pryč.","ws":[8.885,9.255,9.524,9.642]}]},"s2-long":{"w":1280,"h":720,"fps":25,"captionStyle":{"lines":2,"maxChars":40,"size":1,"pos":5,"color":"#ffffff","box":false,"highlight":""},"video":[[{"start":0,"in":20,"out":60,"fit":"contain","posX":0,"posY":0,"scale":1,"disabled":false},{"start":40,"in":66.72,"out":85.48,"fit":"contain","posX":0,"posY":0,"scale":1,"disabled":false},{"start":58.76,"in":212,"out":224.4,"fit":"contain","posX":0,"posY":0,"scale":1,"disabled":false}],[],[]],"audio":[[{"start":0,"in":20,"out":60,"fadeIn":0,"fadeOut":0,"gainDb":0},{"start":40,"in":66.72,"out":85.48,"fadeIn":0,"fadeOut":0,"gainDb":0},{"start":58.76,"in":212,"out":224.4,"fadeIn":0,"fadeOut":0,"gainDb":0}],[],[]],"captions":[{"start":0.17,"end":3.97,"text":"jinou možnost, ty musíš to zvládnout,\nco ti vlastně jako jinýho jako zbývá,","ws":[0.17,0.53,0.93,1.05,1.55,1.65,2.13,2.21,2.35,2.63,2.71,3.01,3.33]},{"start":3.97,"end":7.87,"text":"jako co uděláš, ty se z toho zhroutíš,\nty se zabiješ, nebo jako co uděláš,","ws":[3.97,4.17,4.33,4.91,5.13,5.25,5.37,5.45,6.05,6.13,6.21,6.91,7.07,7.25,7.41]},{"start":7.87,"end":11.07,"text":"prostě když přijde takováhle jako\nztráta, prostě to nejde, ty musíš","ws":[7.87,8.11,8.23,8.39,8.93,9.35,9.91,10.17,10.25,10.65,10.75]},{"start":11.07,"end":14.91,"text":"vlastně pokračovat dál, jako v tom svým\nživotě a hlavně furt vlastně myslíš jako","ws":[11.07,11.25,11.75,12.05,12.49,12.63,12.71,12.95,13.37,13.45,13.85,14.29,14.47,14.77]},{"start":14.91,"end":19.55,"text":"na to, že přece ta máma by nechtěla,\nabych já jako skončila ten život,","ws":[14.91,15.07,15.29,15.51,16.53,16.65,16.93,17.01,17.59,18.07,18.27,18.43,18.93,19.11]},{"start":19.55,"end":23.44,"text":"aby jako tím, že ona už tady není,\nabych já jako přestala myslet na sebe.","ws":[19.55,19.69,19.85,20.15,20.31,20.73,20.89,21.11,21.41,21.61,21.81,22.19,22.53,22.77,22.93]},{"start":23.85,"end":25.4,"text":"Prostě to období bylo...","ws":[23.85,24.25,24.35,24.79]},{"start":26.37,"end":30.993,"text":"strašně jako nečekaný, protože my\njsme nikdo nevěděl, že ona je nemocná.","ws":[26.37,26.855,26.935,27.622,28.167,28.914,29.075,29.297,29.681,29.762,29.923,30.125]},{"start":30.993,"end":33.638,"text":"Jí boleli záda dlouhou dobu.","ws":[30.993,31.478,31.902,32.467,33.153]},{"start":33.638,"end":36.868,"text":"Mysleli jsme si, že si to nějakým\nzpůsobem udělala jako mechanicky,","ws":[33.638,34.021,34.223,34.405,34.466,34.526,34.708,35.112,35.475,35.879,36.222]},{"start":36.868,"end":38.947,"text":"že spadla prostě,\nže jí jako boleli záda.","ws":[36.868,36.969,37.433,37.918,37.999,38.16,38.281,38.624]},{"start":38.947,"end":40,"text":"Ona chodila na fyzioterapie,\nA vlastně...","ws":[38.947,39.048,39.291,39.432,40.05,40.51]},{"start":41.32,"end":45.26,"text":"po strašně dlouhý době a po strašně\nmoc vyšetření, až když ona už","ws":[41.32,41.46,42.08,42.52,42.92,43.02,43.18,43.56,43.82,44.54,44.68,44.88,45.08]},{"start":45.26,"end":50.12,"text":"opravdu nemohla ani chodit\nbolestí, zjistili teprve,","ws":[45.26,46.1,47.18,47.44,47.98,48.78,49.5]},{"start":50.12,"end":54.44,"text":"že ona měla vzácnou formu rakovy,\njmenuje se to mnohočetný myelom,","ws":[50.12,50.52,50.74,51.12,51.74,52.08,52.48,52.78,52.84,52.96,53.58]},{"start":54.44,"end":58.760000000000005,"text":"což je věc, o které já jsem\ndoposavať nikdy neslyšela,","ws":[54.44,55.1,55.16,55.74,55.84,56.12,56.28,56.48,57.58,58.22]},{"start":58.77,"end":62.67,"text":"že vlastně jako to, co se stalo,\ntak ti dá takovou jako bombu,","ws":[58.77,59.09,59.35,59.45,59.65,59.75,59.81,60.29,60.73,60.83,60.99,61.47,61.61]},{"start":62.67,"end":67.39,"text":"takovou ránu a vlastně ty spadneš\núplně fakt jako na dno a to,","ws":[62.67,63.05,63.67,63.77,64.03,64.15,64.51,64.81,64.99,65.23,65.69,66.05,67.07]},{"start":67.39,"end":71.16,"text":"jak se zvedneš, tak potom tě jako\nsformuje podle mě už jako navždycky,","ws":[67.39,67.67,67.83,68.59,68.87,69.21,69.31,69.39,69.87,70.15,70.25,70.33,70.47]}]}}
