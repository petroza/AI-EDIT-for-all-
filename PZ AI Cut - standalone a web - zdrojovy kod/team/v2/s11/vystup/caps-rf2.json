{"s11-a916m":[[0.13,1.36,"A zjistilo / se to strašně,"],[1.45,2.76,"strašně pozdě."],[3.13,3.48,"Takže to přišlo / úplně,"],[4.41,5.15,"jak my jsme / se rozvěděli,"],[5.15,7.18,"že je nemocná a za / tři týdny byla pryč."],[7.36,8.84,"Všechno, / naprosto všechno,"],[8.84,10.26,"protože moje / máma byla"],[10.26,12.53,"tmel té / naší rodiny."],[12.93,14.82,"a byla to / ta nejtěžší"],[14.82,15.12,"věc v mým / životě."]],"s11-k219916m":[[0.65,1.52,"A najednou / byl pryč."]],"s11-sim916m":[[0.19,1.83,"Bych jako / doporučila všem,"],[1.83,4.06,"kdo přichází nebo / přišli do styku"],[4.06,6.09,"s někým, komu / se tohle stalo,"],[6.09,9.67,"tak neříkat / tyhle fádní věci,"],[9.67,12.7,"často zahojí, je teď / líp, tak to mělo"],[12.7,14.41,"být, tohle / fakt nepomáhá."],[14.41,15.91,"Prostě my ani / nepotřebujeme"],[15.91,17.19,"nic slyšet, / my potřebujeme"],[17.19,18.16,"jenom toho / člověka,"],[18.16,20.62,"aby s náma byl, / aby, když se třeba"],[20.62,21.42,"dlouho / neozýváme,"],[21.42,23.41,"aby zavolal a řekl, / já jedu za tebou,"],[23.41,25.17,"já ti vezu jídlo, / nebo prostě"],[25.17,26.36,"pojď, kouknem / se na film."],[26.38,27.5,"Jenom ta / přítomnost toho"],[27.5,29,"člověka chytne / vás za ruku,"],[29,29.8,"něco. prostě."],[29.99,31.05,"Ale my / nepotřebujeme"],[31.05,32.71,"prostě někoho, / aby nám říkal"],[32.71,33.56,"takový ty / chlácholivý věci."],[35.53,37.12,"Jí už je / teď dobře."],[37.37,39.41,"To nepotřebujeme / slyšet."],[39.41,42.01,"Já potřebuju slyšet / něco jako máma"],[42.01,44.05,"byla skvělá, tak jim / i chybí a jsem"],[44.05,45.92,"tady pro tebe, / kdyby cokoliv."]]}
