{"s11-a916m":{"ms":3904,"r":{"name":"s11-a 9x16","shots":7,"facesFound":7,"splits":3,"merged":0},"V1":[[0,1.36,104.6,0.741,"0dt",null],[1.36,2.76,105.96,0.256,"hdu",null],[2.76,3.48,114.88,0.271,"bdv",null],[3.48,7.52,115.6,0.753,"wdw",null],[7.52,12.72,145.96,0.304,"hsh",null],[12.72,15.12,187.96,0.744,"xdx",null],[15.12,16,190.36,0.374,"ddy",null]],"A1":[[0,1.36,104.6,0,"0dt",null],[1.36,2.76,105.96,0,"hdu",null],[2.76,3.48,114.88,0,"bdv",null],[3.48,7.24,115.6,0,"wdw",null],[7.24,12.72,145.68,0,"hsh",null],[12.72,15.12,187.96,0,"xdx",null],[15.12,16,190.36,0,"ddy",null]],"caps":[[0.13,1.45,"A zjistilo / se to strašně,"],[1.45,2.81,"strašně pozdě."],[3.13,4.021,"Takže / to přišlo"],[4.021,5.154,"úplně, jak my / jsme se rozvěděli,"],[5.154,7.23,"že je nemocná a za / tři týdny byla pryč."],[7.36,8.84,"Všechno, / naprosto všechno,"],[8.84,10.26,"protože moje / máma byla"],[10.26,12.58,"tmel té / naší rodiny."],[12.932,14.817,"a byla to / ta nejtěžší"],[14.817,16,"věc v mým / životě."]]},"s11-k219916m":{"ms":475,"r":{"name":"s11-k219 9x16","shots":1,"facesFound":1,"splits":0,"merged":0},"V1":[[0,1.52,1263.6,0.378,"m2o",{"d":0.16,"out":1265.1200000000001}]],"A1":[[0,1.52,1263.6,0,"m2o",null]],"caps":[[0.645,1.52,"A najednou / byl pryč."]]},"s11-sim916m":{"ms":2602,"r":{"name":"s11-sim 9x16","shots":3,"facesFound":3,"splits":1,"merged":0},"V1":[[0,29.8,1544.4,0.298,"h1y",null],[29.8,33.56,1596,0.752,"ee9",null],[33.56,45.92,1599.76,0.319,"vea",null]],"A1":[[0,29.8,1544.4,0,"h1y",null],[29.8,33.56,1596,0,"ee9",null],[33.56,45.92,1599.76,0,"vea",null]],"caps":[[0.19,1.826,"Bych jako / doporučila všem,"],[1.826,4.06,"kdo přichází nebo / přišli do styku"],[4.06,6.095,"s někým, komu / se tohle stalo,"],[6.095,9.666,"tak neříkat / tyhle fádní věci,"],[9.666,12.699,"často zahojí, je teď / líp, tak to mělo"],[12.699,14.414,"být, tohle / fakt nepomáhá."],[14.414,15.91,"Prostě my ani / nepotřebujeme"],[15.91,17.187,"nic slyšet, / my potřebujeme"],[17.187,18.165,"jenom toho / člověka,"],[18.165,20.619,"aby s náma byl, / aby, když se třeba"],[20.619,21.417,"dlouho / neozýváme,"],[21.417,23.412,"aby zavolal a řekl, / já jedu za tebou,"],[23.412,25.506,"já ti vezu jídlo, / nebo prostě pojď,"],[25.506,26.384,"kouknem / se na film."],[26.384,27.501,"Jenom ta / přítomnost toho"],[27.501,28.997,"člověka chytne / vás za ruku,"],[28.997,29.85,"něco. prostě."],[29.99,31.05,"Ale my / nepotřebujeme"],[31.05,32.71,"prostě někoho, / aby nám říkal"],[32.71,34.55,"takový ty / chlácholivý věci."],[35.53,37.37,"Jí už je / teď dobře."],[37.37,39.414,"To nepotřebujeme / slyšet."],[39.414,42.009,"Já potřebuju slyšet / něco jako máma"],[42.009,44.053,"byla skvělá, tak jim / i chybí a jsem"],[44.053,45.92,"tady pro tebe, / kdyby cokoliv."]]}}
