y,","ws":[8.645,9.373,10.12,10.304,10.55,10.858,11.35,11.719]},{"start":12.211,"end":15.278,"text":"jmenuje se to mnohočetný\nmyelom, což je věc,","ws":[12.211,12.703,12.887,13.072,13.748,14.34,14.653,14.887]},{"start":15.278,"end":18.76,"text":"o které já jsem doposavať\nnikdy neslyšela,","ws":[15.278,15.435,15.904,16.138,16.529,17.311,17.78]},{"start":18.76,"end":21.828,"text":"Že vlastně jako to, co\nse stalo, tak ti dá takovou","ws":[18.76,18.94,19.422,19.723,19.963,20.144,20.324,20.745,20.986,21.166,21.347]},{"start":21.828,"end":25.111,"text":"jako bombu, takovou ránu\na vlastně ty spadneš","ws":[21.828,22.129,22.65,23.229,23.591,23.736,24.315,24.532]},{"start":25.111,"end":28.155,"text":"úplně fakt jako na dno\na to, jak se zvedneš,","ws":[25.111,25.545,25.907,26.269,26.486,26.776,26.92,27.31,27.521,27.68]},{"start":28.155,"end":31.16,"text":"tak potom tě jako sformuje\npodle mě už jako navždycky,","ws":[28.155,28.366,28.683,28.842,29.106,29.581,29.898,30.056,30.215,30.479]}]},"s1-d":{"w":1080,"h":1080,"fps":25,"title":{"text":"Máma byla tmel rodiny","size":1},"captionStyle":{"lines":2,"maxChars":30,"size":1,"pos":7,"color":"#ffffff","box":false},"video":[[{"start":0,"in":127.36,"out":135.96,"fit":"cover","posX":0.48713882991245816,"posY":0,"scale":1,"vIn":null,"vOut":null,"disabled":false},{"start":8.6,"in":145.68,"out":145.96,"fit":"cover","posX":-0.3969614846365792,"posY":0,"scale":1,"vIn":null,"vOut":null,"disabled":false},{"start":8.88,"in":145.96,"out":163.12,"fit":"cover","posX":0.49157521384102965,"posY":0,"scale":1,"vIn":null,"vOut":null,"disabled":false},{"start":26.04,"in":183.56,"out":184.96,"fit":"cover","posX":0.4767196655273438,"posY":0,"scale":1,"vIn":null,"vOut":null,"disabled":false},{"start":27.44,"in":184.96,"out":185.16,"fit":"cover","posX":1,"posY":0,"scale":1,"vIn":null,"vOut":null,"disabled":false}],[],[]],"audio":[[{"start":0,"in":127.36,"out":135.96,"fadeIn":0.08,"fadeOut":0.08,"gainDb":0},{"start":8.6,"in":145.68,"out":163.12,"fadeI