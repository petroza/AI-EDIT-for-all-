{"vystup-r8-a":{"w":1280,"h":720,"fps":25,"title":null,"captionStyle":null,"video":[[{"start":0,"in":104.24000000000001,"out":107.84,"fit":"contain","posX":0,"posY":0,"scale":1},{"start":3.6,"in":115.60000000000001,"out":119.6,"fit":"contain","posX":0,"posY":0,"scale":1},{"start":7.6,"in":145.96,"out":151.20000000000002,"fit":"contain","posX":0,"posY":0,"scale":1},{"start":12.84,"in":188.20000000000002,"out":191.20000000000002,"fit":"contain","posX":0,"posY":0,"scale":1}],[],[]],"audio":[[{"start":0,"in":104.24000000000001,"out":107.44,"fadeIn":0.0032,"fadeOut":0.0032},{"start":3.2,"in":115.2,"out":119.52,"fadeIn":0.0032,"fadeOut":0.0032},{"start":7.52,"in":145.88,"out":151.20000000000002,"fadeIn":0.0032,"fadeOut":0.0032},{"start":12.84,"in":188.20000000000002,"out":191.20000000000002,"fadeIn":0.0032,"fadeOut":0.0032}],[],[]],"captions":[{"start":0.077,"end":3.245,"text":"dále. A zjistilo se to\nstrašně, strašně pozdě.","ws":[0.077,0.55,0.676,1.242,1.431,1.62,2.186,2.69]},{"start":3.33,"end":5.519,"text":"Takže to přišlo úplně,\njako my jsme se rozvěděli,","ws":[3.33,3.593,3.724,4.03,4.337,4.556,4.687,4.906,5.037]},{"start":5.519,"end":7.399,"text":"že je nemocná a za tři\ntýdny byla pryč.","ws":[5.519,5.65,5.782,6.132,6.219,6.351,6.526,6.788,7.007]},{"start":7.52,"end":9.55,"text":"Všechno, naprosto všechno,","ws":[7.52,8.173,8.861]},{"start":9.55,"end":12.786,"text":"protože moje máma\nbyla tmel naší rodiny.","ws":[9.55,10.161,10.544,10.926,11.309,11.691,12.073]},{"start":12.915,"end":15.84,"text":"A byla to ta nejtěžší\nvěc v mém životě.","ws":[12.915,13.065,13.44,13.665,13.89,14.565,14.865,15.015,15.315]}]},"vystup-r8-a 9x16":{"w":1080,"h":1920,"fps":25,"title":{"text":"Mámu ztratila za tři týdny","size":1},"captionStyle":null,"video":[[{"start":0,"in":104.24000000000001,"out":105.96000000000001,"fit":"cover","posX":0.7402616582407893,"posY":0,"scale":1},{"start":1.72,"in":105.96000000000001,"out":107.84,"fit":"cover","posX":0.2409596153661271,"posY":0,"scale":1},{"start":3.6,"in":115.60000000000001,"out":119.6,"fit":"cover","posX":0.7530832934119638,"posY":0,"scale":1},{"start":7.6,"in":145.96,"out":151.20000000000002,"fit":"cover","posX":0.30360274802497744,"posY":0,"scale":1},{"start":12.84,"in":188.20000000000002,"out":190.36,"fit":"cover","posX":0.7454476696021048,"posY":0,"scale":1},{"start":15,"in":190.36,"out":191.20000000000002,"fit":"cover","posX":0.37392129256295403,"posY":0,"scale":1}],[],[]],"audio":[[{"start":0,"in":104.24000000000001,"out":107.44,"fadeIn":0.0032,"fadeOut":0.0032},{"start":3.2,"in":115.2,"out":119.52,"fadeIn":0.0032,"fadeOut":0.0032},{"start":7.52,"in":145.88,"out":151.20000000000002,"fadeIn":0.0032,"fadeOut":0.0032},{"start":12.84,"in":188.20000000000002,"out":191.20000000000002,"fadeIn":0.0032,"fadeOut":0.0032}],[],[]],"captions":[{"start":0.077,"end":0.55,"text":"dále.","ws":[0.077]},{"start":0.55,"end":2.186,"text":"A zjistilo\nse to strašně,","ws":[0.55,0.676,1.242,1.431,1.62]},{"start":2.186,"end":3.295,"text":"strašně pozdě.","ws":[2.186,2.69]},{"start":3.33,"end":4.337,"text":"Takže to přišlo\núplně,","ws":[3.33,3.593,3.724,4.03]},{"start":4.337,"end":5.519,"text":"jako my jsme\nse rozvěděli,","ws":[4.337,4.556,4.687,4.906,5.037]},{"start":5.519,"end":7.449,"text":"že je nemocná a za\ntři týdny byla pryč.","ws":[5.519,5.65,5.782,6.132,6.219,6.351,6.526,6.788,7.007]},{"start":7.52,"end":10.161,"text":"Všechno, naprosto\nvšechno, protože","ws":[7.52,8.173,8.861,9.55]},{"start":10.161,"end":12.836,"text":"moje máma byla\ntmel naší rodiny.","ws":[10.161,10.544,10.926,11.309,11.691,12.073]},{"start":12.915,"end":14.565,"text":"A byla to\nta nejtěžší","ws":[12.915,13.065,13.44,13.665,13.89]},{"start":14.565,"end":15.84,"text":"věc v mém\nživotě.","ws":[14.565,14.865,15.015,15.315]}]},"vystup-r8-c":{"w":1080,"h":1350,"fps":25,"title":{"text":"Nemoc, o které nikdy neslyšela","size":1},"captionStyle":null,"video":[[{"start":0,"in":67.04,"out":73.88000000000001,"fit":"cover","posX":0.41625660437498024,"posY":0,"scale":1},{"start":6.84,"in":73.88000000000001,"out":77.84,"fit":"cover","posX":0.9254899359796627,"posY":0,"scale":1},{"start":10.8,"in":77.84,"out":85.88,"fit":"cover","posX":0.39287770524134613,"posY":0,"scale":1},{"start":18.84,"in":212.04,"out":221.48,"fit":"cover","posX":0.36250420422140084,"posY":0,"scale":1},{"start":28.28,"in":221.48,"out":227.2,"fit":"cover","posX":0.9212705486750055,"posY":0,"scale":1},{"start":34,"in":227.2,"out":228.28,"fit":"cover","posX":0.4079048545548607,"posY":0,"scale":1}],[],[]],"audio":[[{"start":0,"in":67.04,"out":85.88,"fadeIn":0.0032,"fadeOut":0.0032},{"start":18.84,"in":212.04,"out":228.28,"fadeIn":0.0032,"fadeOut":0.0032}],[],[]],"captions":[{"start":0.01,"end":3.953,"text":"A vlastně po strašně dlouhé\ndobě a po strašně moc","ws":[0.01,0.168,0.799,1.035,1.666,2.218,2.612,2.77,3.006,3.637]},{"start":3.953,"end":7.895,"text":"vyšetření, až když ona\nopravdu nemohla ani chodit","ws":[3.953,4.82,5.057,5.451,5.766,6.397,7.028,7.343]},{"start":7.895,"end":11.195,"text":"bolestí, zjistili teprve,\nže ona měla vzácnou","ws":[7.895,8.605,9.235,9.795,10.005,10.285,10.635]},{"start":11.195,"end":14.605,"text":"formu rakovin, jmenuje\nse to mnohočetný myelom,","ws":[11.195,11.615,12.245,12.817,13.032,13.246,14.033]},{"start":14.605,"end":18.589,"text":"což je věc, o které jsem\ndoposavať nikdy neslyšela.","ws":[14.605,14.905,15.13,15.505,15.655,16.105,16.48,17.23,17.68]},{"start":19.025,"end":21.058,"text":"Že vlastně jako to,\nco se stalo,","ws":[19.025,19.21,19.703,20.011,20.257,20.442,20.627]},{"start":21.058,"end":23.707,"text":"tak ti dá takovou\njako bombu, takovou ránu","ws":[21.058,21.305,21.489,21.674,22.167,22.475,22.906,23.399]},{"start":23.707,"end":26.308,"text":"a vlastně ty spadneš\núplně fakt jako na dno.","ws":[23.707,23.817,24.257,24.422,24.861,25.191,25.466,25.741,25.906]},{"start":27.16,"end":28.314,"text":"A to, jak\nse zvedneš,","ws":[27.16,27.265,27.475,27.685,27.842]},{"start":28.314,"end":31.2,"text":"tak potom tě jako sformuje\npodle mě už jako navždycky.","ws":[28.314,28.524,28.839,28.996,29.259,29.731,30.046,30.203,30.361,30.623]},{"start":31.2,"end":32.576,"text":"Protože prostě\nten člověk,","ws":[31.2,31.608,31.964,32.168]},{"start":32.576,"end":35.046,"text":"který byl před tímhle vším,\ntak už jako není.","ws":[32.576,32.882,33.085,33.34,33.697,34.003,34.207,34.359,34.614]}]},"vystup-r8-d":{"w":1280,"h":720,"fps":25,"title":null,"captionStyle":null,"video":[[{"start":0,"in":128.24,"out":136.12,"fit":"contain","posX":0,"posY":0,"scale":1},{"start":7.88,"in":145.96,"out":163.20000000000002,"fit":"contain","posX":0,"posY":0,"scale":1},{"start":25.12,"in":184.08,"out":185.36,"fit":"contain","posX":0,"posY":0,"scale":1}],[],[]],"audio":[[{"start":0,"in":128.24,"out":136.04,"fadeIn":0.0032,"fadeOut":0.0032},{"start":7.8,"in":145.88,"out":163.20000000000002,"fadeIn":0.0032,"fadeOut":0.0032},{"start":25.12,"in":184.08,"out":185.36,"fadeIn":0.0032,"fadeOut":0.0032}],[],[]],"captions":[{"start":0.812,"end":4.845,"text":"možnost se připravit\na jediné, co nám zbylo,","ws":[0.812,1.529,1.798,2.694,2.873,3.59,3.859,4.218]},{"start":4.845,"end":7.8,"text":"tak se s tím poprat,\nzvládnout.","ws":[4.845,5.217,5.496,5.681,6.053,6.797]},{"start":7.8,"end":9.83,"text":"Všechno, naprosto všechno,","ws":[7.8,8.453,9.141]},{"start":9.83,"end":12.965,"text":"protože moje máma\nbyla tmel naší rodiny.","ws":[9.83,10.441,10.824,11.206,11.589,11.971,12.353]},{"start":12.965,"end":15.98,"text":"To byl někdo,\nkdo držel celou rodinu,","ws":[12.965,13.203,13.52,14.076,14.393,14.869,15.345]},{"start":15.98,"end":20.782,"text":"pohromadě a kdo zvolával\nnás jako všechny,","ws":[15.98,17.33,17.6,18.099,19.221,19.72,20.099]},{"start":20.782,"end":25.06,"text":"jako na obědy, prostě svátky,\nnarození, ona všechno organizovala.","ws":[20.782,21.161,21.389,22.16,22.608,23.12,23.8,23.978,24.335]},{"start":25.175,"end":26.4,"text":"A najednou byl pryč.","ws":[25.175,25.303,25.877,26.132]}]},"vystup-r8-d 1x1":{"w":1080,"h":1080,"fps":25,"title":{"text":"Máma byla tmel rodiny","size":1},"captionStyle":null,"video":[[{"start":0,"in":128.24,"out":136.12,"fit":"cover","posX":0.5319923862948583,"posY":0,"scale":1},{"start":7.88,"in":145.96,"out":163.20000000000002,"fit":"cover","posX":0.5356009609270949,"posY":0,"scale":1},{"start":25.12,"in":184.08,"out":184.96,"fit":"cover","posX":0.5748257555241116,"posY":0,"scale":1},{"start":26,"in":184.96,"out":185.36,"fit":"cover","posX":1,"posY":0,"scale":1}],[],[]],"audio":[[{"start":0,"in":128.24,"out":136.04,"fadeIn":0.0032,"fadeOut":0.0032},{"start":7.8,"in":145.88,"out":163.20000000000002,"fadeIn":0.0032,"fadeOut":0.0032},{"start":25.12,"in":184.08,"out":185.36,"fadeIn":0.0032,"fadeOut":0.0032}],[],[]],"captions":[{"start":0.812,"end":4.845,"text":"možnost se připravit\na jediné, co nám zbylo,","ws":[0.812,1.529,1.798,2.694,2.873,3.59,3.859,4.218]},{"start":4.845,"end":7.8,"text":"tak se s tím poprat,\nzvládnout.","ws":[4.845,5.217,5.496,5.681,6.053,6.797]},{"start":7.8,"end":9.83,"text":"Všechno,\nnaprosto všechno,","ws":[7.8,8.453,9.141]},{"start":9.83,"end":12.965,"text":"protože moje máma\nbyla tmel naší rodiny.","ws":[9.83,10.441,10.824,11.206,11.589,11.971,12.353]},{"start":12.965,"end":17.33,"text":"To byl někdo, kdo držel\ncelou rodinu, pohromadě","ws":[12.965,13.203,13.52,14.076,14.393,14.869,15.345,15.98]},{"start":17.33,"end":22.16,"text":"a kdo zvolával nás jako\nvšechny, jako na obědy,","ws":[17.33,17.6,18.099,19.221,19.72,20.099,20.782,21.161,21.389]},{"start":22.16,"end":25.11,"text":"prostě svátky, narození,\nona všechno organizovala.","ws":[22.16,22.608,23.12,23.8,23.978,24.335]},{"start":25.175,"end":26.4,"text":"A najednou byl pryč.","ws":[25.175,25.303,25.877,26.132]}]},"vystup-r8-e":{"w":1080,"h":1080,"fps":25,"title":{"text":"Ze snídaně rovnou do zpráv","size":1},"captionStyle":null,"video":[[{"start":0,"in":680.2,"out":680.84,"fit":"cover","posX":1,"posY":0,"scale":1},{"start":0.64,"in":680.84,"out":685.52,"fit":"cover","posX":0.4651637481423909,"posY":0,"scale":1},{"start":5.32,"in":685.52,"out":687.52,"fit":"cover","posX":1,"posY":0,"scale":1},{"start":7.32,"in":713.5600000000001,"out":720.72,"fit":"cover","posX":0.4200459083966388,"posY":0,"scale":1},{"start":14.48,"in":720.72,"out":724.88,"fit":"cover","posX":1,"posY":0,"scale":1},{"start":18.64,"in":920.12,"out":922.56,"fit":"cover","posX":1,"posY":0,"scale":1},{"start":21.08,"in":922.56,"out":942.64,"fit":"cover","posX":0.5639854468923013,"posY":0,"scale":1}],[],[]],"audio":[[{"start":0,"in":680.2,"out":687.52,"fadeIn":0.0032,"fadeOut":0.0032},{"start":7.32,"in":713.5600000000001,"out":724.88,"fadeIn":0.0032,"fadeOut":0.0032},{"start":18.64,"in":920.12,"out":942.64,"fadeIn":0.0032,"fadeOut":0.0032}],[],[]],"captions":[{"start":0.105,"end":3.136,"text":"Já jsem najednou\nneměla pozici.","ws":[0.105,0.381,0.84,1.667,2.31]},{"start":3.19,"end":5.465,"text":"To bylo vlastně docela\ndramatický období.","ws":[3.19,3.347,3.608,4.026,4.391,4.966]},{"start":5.465,"end":7.237,"text":"Já jsem vlastně nevěděla,\nco se mnou bude.","ws":[5.465,5.58,5.771,6.076,6.457,6.572,6.686,6.877]},{"start":7.517,"end":9.326,"text":"Tam se začala\nformovat podle mě","ws":[7.517,7.743,7.913,8.308,8.817,9.156]},{"start":9.326,"end":11.19,"text":"ta moje moderátorská\nzkušenost.","ws":[9.326,9.495,9.778,10.512]},{"start":11.19,"end":13.324,"text":"Že jsem najednou zapravo,\njá jsem začala","ws":[11.19,11.346,11.606,12.075,12.543,12.699,12.959]},{"start":13.324,"end":15.572,"text":"nasávat zkušenosti\nod hlavních moderátorů.","ws":[13.324,13.74,14.313,14.469,14.937]},{"start":15.572,"end":18.65,"text":"To bylo neuvěřitelné,\nco mě tohle dalo.","ws":[15.572,15.803,16.188,17.265,17.496,17.727,18.189]},{"start":18.65,"end":21.241,"text":"Tak když mě povolali\nze snídaně přímo","ws":[18.65,18.923,19.264,19.468,20.082,20.286,20.832]},{"start":21.241,"end":24.65,"text":"do spravodajství, tak to\nbyl pro mě extrémní šok.","ws":[21.241,21.445,22.468,22.741,22.945,23.218,23.491,23.695,24.309]},{"start":24.65,"end":29.603,"text":"To se přiznám, že jsem to\nobrečela, hodně se mi nechtělo","ws":[24.65,24.911,25.171,25.953,26.214,26.648,26.909,27.778,28.299,28.56,28.821]},{"start":29.603,"end":33.773,"text":"ze snídaně sem a bylo\nto pro mě velmi šokující,","ws":[29.603,29.863,30.559,30.906,31.08,31.514,31.775,32.123,32.383,32.905]},{"start":33.773,"end":37.359,"text":"hlavně to teda přišlo v\nnejhorším období v mém životě,","ws":[33.773,34.382,34.642,35.077,35.685,35.786,36.294,36.649,36.75,36.953]},{"start":37.359,"end":39.388,"text":"že bylo jako strašně\nmoc změn a já jsem","ws":[37.359,37.511,37.765,38.018,38.424,38.627,38.881,38.982,39.134]},{"start":39.388,"end":41.16,"text":"musela měnit i jako\npracovní pozici.","ws":[39.388,39.743,40.048,40.149,40.403,40.859]}]}}